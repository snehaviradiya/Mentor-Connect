# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite default for local development, PostgreSQL compatible)
DATABASE_URL="file:./dev.db"

# JWT Authentication
# Generate a private random value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-private-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# CORS Configuration
# Comma-separated browser origins; localhost development origins are allowed by default outside production.
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Jitsi Meet Video Integration
JITSI_DOMAIN="meet.jit.si"
# Optional Jitsi credentials for self-hosted / 8x8 JaaS enterprise deployments
# JITSI_APP_ID=""
# JITSI_JWT_SECRET=""
